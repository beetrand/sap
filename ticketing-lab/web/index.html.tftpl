<!doctype html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#090909" />
  <title>VANTA TICKETS — Seat Reservation</title>
  <style>
    /* 外部FontはCloudFront配信後にBrowserがGoogle Fontsから取得する。 */
    @import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap");

    /* 色やFontを変える時、画面全体を探さずここで調整できるDesign Token。 */
    :root {
      color-scheme: dark;
      font-family: "DM Sans", system-ui, sans-serif;
      --bg: #090909;
      --panel: rgba(20, 20, 20, .9);
      --ink: #f6f3eb;
      --muted: #9b9993;
      --line: rgba(255, 255, 255, .11);
      --accent: #d9ff5b;
      --accent-ink: #111407;
      --danger: #ff9a88;
    }

    * { box-sizing: border-box; }
    body {
      min-width: 320px;
      min-height: 100vh;
      margin: 0;
      background:
        radial-gradient(circle at 10% 0, rgba(112, 69, 255, .2), transparent 31rem),
        radial-gradient(circle at 100% 35%, rgba(217, 255, 91, .08), transparent 26rem),
        var(--bg);
      color: var(--ink);
    }
    button, input { font: inherit; }

    /* Site名と安全な模擬予約であることを示すHeader。 */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: min(1180px, calc(100% - 40px));
      height: 76px;
      margin: auto;
      border-bottom: 1px solid var(--line);
    }
    .brand {
      display: flex;
      align-items: center;
      gap: 11px;
      color: var(--ink);
      font: 800 15px/1 "Manrope", sans-serif;
      letter-spacing: .15em;
      text-decoration: none;
    }
    .brand-mark {
      display: grid;
      width: 30px;
      height: 30px;
      place-items: center;
      border-radius: 50%;
      background: var(--accent);
      color: var(--accent-ink);
      font-size: 12px;
      letter-spacing: -.08em;
    }
    .top-meta { display: flex; gap: 20px; color: var(--muted); font-size: 12px; }
    .secure { display: flex; align-items: center; gap: 7px; }
    .secure::before {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 12px rgba(217, 255, 91, .7);
      content: "";
    }

    main { width: min(1180px, calc(100% - 40px)); margin: 28px auto 80px; }
    /* Eventの第一印象と基本情報を表示するHero Area。画像Fileを使わずCSSでArtworkを描く。 */
    .hero {
      position: relative;
      display: grid;
      min-height: 360px;
      grid-template-columns: 1.15fr .85fr;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 26px;
      background: #151515;
      isolation: isolate;
    }
    .hero-copy {
      z-index: 2;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: 44px;
    }
    .eyebrow {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 0 0 17px;
      color: var(--accent);
      font: 700 12px/1 "Manrope", sans-serif;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .eyebrow::before { width: 28px; height: 1px; background: currentColor; content: ""; }
    h1 {
      max-width: 690px;
      margin: 0;
      font: 800 clamp(42px, 6vw, 76px)/.98 "Manrope", sans-serif;
      letter-spacing: -.055em;
    }
    .event-details { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 27px; color: #d1cec7; font-size: 15px; }
    .event-detail { display: flex; align-items: center; gap: 9px; }
    .event-icon { color: var(--accent); }
    .hero-art {
      position: relative;
      min-height: 360px;
      background:
        linear-gradient(135deg, transparent 5%, rgba(217, 255, 91, .17) 45%, transparent 46%),
        radial-gradient(circle at 55% 44%, #8060ff 0, #3a216f 20%, transparent 45%),
        linear-gradient(135deg, #101010, #20152c 58%, #1c2512);
    }
    .hero-art::before, .hero-art::after {
      position: absolute;
      border: 1px solid rgba(255, 255, 255, .17);
      border-radius: 50%;
      content: "";
    }
    .hero-art::before { inset: 45px -80px -100px 40px; box-shadow: inset 0 0 80px rgba(217,255,91,.08); }
    .hero-art::after { top: 34px; right: 45px; width: 170px; height: 170px; border-color: rgba(217,255,91,.46); box-shadow: 0 0 80px rgba(217,255,91,.12); }
    .art-type {
      position: absolute;
      right: 32px;
      bottom: 26px;
      font: 800 clamp(46px, 6vw, 86px)/.77 "Manrope", sans-serif;
      letter-spacing: -.08em;
      text-align: right;
      transform: rotate(-4deg);
    }
    .art-type span { display: block; color: var(--accent); }

    /* Desktopでは座席表と予約Summaryを2 Columnにする。 */
    .content-grid { display: grid; grid-template-columns: minmax(0, 1fr) 350px; gap: 24px; margin-top: 24px; align-items: start; }
    .panel {
      border: 1px solid var(--line);
      border-radius: 22px;
      background: var(--panel);
      box-shadow: 0 18px 70px rgba(0,0,0,.16);
      backdrop-filter: blur(18px);
    }
    .seat-panel { padding: 30px; }
    .panel-heading { display: flex; justify-content: space-between; gap: 20px; margin-bottom: 30px; }
    h2 { margin: 0; font: 700 23px/1.2 "Manrope", sans-serif; letter-spacing: -.03em; }
    .subtitle { margin: 7px 0 0; color: var(--muted); font-size: 14px; }
    .availability {
      height: fit-content;
      padding: 7px 11px;
      border: 1px solid rgba(217,255,91,.24);
      border-radius: 999px;
      background: rgba(217,255,91,.07);
      color: var(--accent);
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }
    .stage-wrap { width: min(520px, 90%); margin: 4px auto 38px; text-align: center; }
    .stage { height: 7px; border-radius: 50%; background: linear-gradient(90deg, transparent, var(--accent), transparent); box-shadow: 0 9px 24px rgba(217,255,91,.25); }
    .stage-label { margin-top: 11px; color: #77756f; font: 700 10px/1 "Manrope", sans-serif; letter-spacing: .25em; }
    /* Seat数が増えても同じButton ComponentをGridへ並べられる。 */
    .seats { display: grid; width: min(630px, 100%); grid-template-columns: repeat(5, minmax(60px, 1fr)); gap: 13px; margin: auto; }
    .seat {
      position: relative;
      min-height: 65px;
      padding: 10px 7px;
      border: 1px solid #373737;
      border-radius: 12px 12px 15px 15px;
      background: #202020;
      color: var(--ink);
      cursor: pointer;
      transition: 150ms ease;
    }
    .seat::after { position: absolute; right: 9px; bottom: 7px; left: 9px; height: 4px; border-radius: 6px; background: #393939; content: ""; }
    .seat:hover:not(:disabled) { z-index: 1; border-color: #777; background: #292929; transform: translateY(-3px); }
    .seat:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
    .seat.selected { border-color: var(--accent); background: var(--accent); color: var(--accent-ink); transform: translateY(-3px); }
    .seat.selected::after { background: rgba(16,18,6,.3); }
    .seat.held, .seat.sold { border-color: #242424; background: #151515; color: #555; cursor: not-allowed; }
    .seat-code { display: block; font-size: 14px; font-weight: 700; }
    .seat-price { display: block; margin-top: 3px; font-size: 10px; opacity: .65; }
    .legend { display: flex; justify-content: center; gap: 24px; margin-top: 30px; color: var(--muted); font-size: 12px; }
    .legend-item { display: flex; align-items: center; gap: 8px; }
    .legend-dot { width: 10px; height: 10px; border: 1px solid #454545; border-radius: 3px; background: #202020; }
    .legend-dot.active { border-color: var(--accent); background: var(--accent); }
    .legend-dot.unavailable { border-color: #242424; background: #151515; }

    /* Scroll中も選択内容を確認できるよう、Desktopでは右Columnを固定する。 */
    .summary { position: sticky; top: 24px; padding: 26px; }
    .summary-event { margin: 19px 0 22px; padding-bottom: 20px; border-bottom: 1px solid var(--line); }
    .summary-event strong, .summary-event span { display: block; }
    .summary-event strong { font-size: 14px; }
    .summary-event span { margin-top: 5px; color: var(--muted); font-size: 12px; line-height: 1.5; }
    .empty-selection {
      display: grid;
      min-height: 92px;
      place-items: center;
      border: 1px dashed #383838;
      border-radius: 13px;
      color: #77756f;
      font-size: 13px;
      text-align: center;
    }
    .ticket-selection {
      display: none;
      min-height: 92px;
      align-items: center;
      justify-content: space-between;
      padding: 17px;
      border: 1px solid rgba(217,255,91,.22);
      border-radius: 13px;
      background: rgba(217,255,91,.055);
    }
    .ticket-selection.visible { display: flex; }
    .seat-name { font: 700 20px/1 "Manrope", sans-serif; }
    .seat-area { margin-top: 6px; color: var(--muted); font-size: 12px; }
    .ticket-price { font-weight: 700; }
    label { display: block; margin: 22px 0 8px; color: #c7c5be; font-size: 12px; font-weight: 600; }
    input {
      width: 100%;
      height: 46px;
      padding: 0 13px;
      border: 1px solid #353535;
      border-radius: 11px;
      outline: 0;
      background: #101010;
      color: var(--ink);
    }
    input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px rgba(217,255,91,.09); }
    .price-lines { display: grid; gap: 11px; margin: 22px 0; color: var(--muted); font-size: 13px; }
    .price-line { display: flex; justify-content: space-between; gap: 16px; }
    .price-line.total { padding-top: 15px; border-top: 1px solid var(--line); color: var(--ink); font-size: 16px; font-weight: 700; }
    .reserve {
      width: 100%;
      min-height: 51px;
      border: 0;
      border-radius: 12px;
      background: var(--accent);
      color: var(--accent-ink);
      cursor: pointer;
      font: 800 14px/1 "Manrope", sans-serif;
      transition: 150ms ease;
    }
    .reserve:hover:not(:disabled) { filter: brightness(1.08); transform: translateY(-1px); }
    .reserve:disabled { background: #282828; color: #666; cursor: not-allowed; }
    .fine-print { margin: 13px 0 0; color: #6e6c67; font-size: 10px; line-height: 1.6; text-align: center; }
    .message { display: none; margin: 17px 0 0; padding: 12px 13px; border-radius: 10px; font-size: 12px; line-height: 1.45; }
    .message.visible { display: block; }
    .message.success { background: rgba(217,255,91,.09); color: var(--accent); }
    .message.error { background: rgba(255,154,136,.1); color: var(--danger); }
    .skeleton { min-height: 65px; border-radius: 12px; background: linear-gradient(90deg,#171717,#252525,#171717); background-size: 220% 100%; animation: shimmer 1.35s infinite linear; }
    @keyframes shimmer { to { background-position: -220% 0; } }

    /* Tablet以下では2 Columnを縦並びにし、Summaryの固定を解除する。 */
    @media (max-width: 900px) {
      .hero { grid-template-columns: 1fr; }
      .hero-copy { min-height: 340px; }
      .hero-art { position: absolute; inset: 0 0 0 38%; z-index: -1; opacity: .72; }
      .content-grid { grid-template-columns: 1fr; }
      .summary { position: static; }
    }
    /* Mobileでは余白とSeat列数を減らす。 */
    @media (max-width: 600px) {
      .topbar, main { width: calc(100% - 28px); }
      .topbar { height: 66px; }
      .top-meta > span:first-child { display: none; }
      main { margin-top: 16px; }
      .hero, .hero-copy { min-height: 410px; }
      .hero { border-radius: 20px; }
      .hero-copy { padding: 26px; }
      .hero-art { inset: 0; opacity: .52; }
      .art-type { right: 20px; bottom: 28px; font-size: 58px; opacity: .55; }
      .seat-panel { padding: 22px 16px; }
      .seats { grid-template-columns: repeat(4, 1fr); gap: 9px; }
      .legend { flex-wrap: wrap; gap: 14px; }
    }
    /* OSでAnimation低減を選んだ利用者には動きをほぼ無効化する。 */
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
    }
  </style>
</head>
<body>
  <!-- Brand Header。実際の決済SiteではLoginや購入履歴へのLinkもここへ置く。 -->
  <nav class="topbar" aria-label="メインナビゲーション">
    <a class="brand" href="#"><span class="brand-mark">V</span>VANTA TICKETS</a>
    <div class="top-meta"><span>Official ticketing partner</span><span class="secure">Secure booking</span></div>
  </nav>

  <main>
    <!-- APIから取得したEvent名、日時、会場を表示する。 -->
    <section class="hero" aria-labelledby="event-title">
      <div class="hero-copy">
        <p class="eyebrow">Live in Tokyo · One night only</p>
        <h1 id="event-title">SAP Learning Live</h1>
        <div class="event-details">
          <span class="event-detail"><span class="event-icon">●</span><span id="event-date">日時を読み込み中</span></span>
          <span class="event-detail"><span class="event-icon">⌖</span><span id="event-venue">会場を読み込み中</span></span>
        </div>
      </div>
      <div class="hero-art" aria-hidden="true"><div class="art-type">NIGHT<span>PULSE</span></div></div>
    </section>

    <div class="content-grid">
      <!-- 左側: DBから取得した座席を選ぶArea。 -->
      <section class="panel seat-panel" aria-labelledby="seat-heading">
        <div class="panel-heading">
          <div><h2 id="seat-heading">座席を選択</h2><p class="subtitle">お好きな席を1席お選びください</p></div>
          <span class="availability" id="availability">空席を確認中</span>
        </div>
        <div class="stage-wrap" aria-hidden="true"><div class="stage"></div><div class="stage-label">STAGE</div></div>
        <!-- 読込中はSkeletonを表示し、API完了後にJavaScriptがSeat Buttonへ置換する。 -->
        <div class="seats" id="seats" aria-live="polite">
          <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
          <div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div><div class="skeleton"></div>
        </div>
        <div class="legend" aria-label="座席状態">
          <span class="legend-item"><span class="legend-dot"></span>選択可能</span>
          <span class="legend-item"><span class="legend-dot active"></span>選択中</span>
          <span class="legend-item"><span class="legend-dot unavailable"></span>予約済み</span>
        </div>
      </section>

      <!-- 右側: 選択Seat、予約者名、料金を確認してPOSTするArea。 -->
      <aside class="panel summary" aria-labelledby="summary-heading">
        <h2 id="summary-heading">ご予約内容</h2>
        <div class="summary-event"><strong id="summary-name">SAP Learning Live</strong><span id="summary-meta">日時・会場を読み込み中</span></div>
        <div class="empty-selection" id="empty-selection">座席を選択すると<br />ここに表示されます</div>
        <div class="ticket-selection" id="ticket-selection">
          <div><span class="seat-name" id="selected-name">—</span><div class="seat-area">指定席 · Aブロック</div></div>
          <span class="ticket-price" id="selected-price">—</span>
        </div>
        <label for="customer-name">予約者名</label>
        <input id="customer-name" maxlength="100" autocomplete="name" placeholder="例：山田 太郎" />
        <div class="price-lines">
          <div class="price-line"><span>チケット</span><span id="subtotal">—</span></div>
          <div class="price-line"><span>システム利用料</span><span>¥550</span></div>
          <div class="price-line total"><span>合計</span><span id="total">—</span></div>
        </div>
        <button class="reserve" id="reserve" type="button" disabled>この内容で予約する</button>
        <p class="fine-print">AWSアーキテクチャ学習用の模擬予約です。<br />実際の決済は発生しません。</p>
        <p class="message" id="message" role="status" aria-live="polite"></p>
      </aside>
    </div>
  </main>

  <script>
    // TerraformがAPI Gateway URLをJSON Stringとしてここへ埋め込む。
    const api = ${jsonencode(api_url)};
    // 模擬手数料。現在はDBへ保存せず、画面の現実感を出す表示だけに使う。
    const fee = 550;
    // 画面全体で共有する状態。Frameworkを使わない小規模構成なのでObject 1つで管理する。
    const state = { event: null, seats: [], selected: null, busy: false };
    // 何度も使うDOM Elementを最初に取得しておく。
    const el = {
      title: document.querySelector("#event-title"), date: document.querySelector("#event-date"), venue: document.querySelector("#event-venue"),
      seats: document.querySelector("#seats"), availability: document.querySelector("#availability"), summaryName: document.querySelector("#summary-name"),
      summaryMeta: document.querySelector("#summary-meta"), empty: document.querySelector("#empty-selection"), ticket: document.querySelector("#ticket-selection"),
      selectedName: document.querySelector("#selected-name"), selectedPrice: document.querySelector("#selected-price"), customer: document.querySelector("#customer-name"),
      subtotal: document.querySelector("#subtotal"), total: document.querySelector("#total"), reserve: document.querySelector("#reserve"), message: document.querySelector("#message")
    };

    // fetchの共通処理。HTTP ErrorもJavaScript Errorへ変換し、呼出元のcatchへ渡す。
    async function request(path, options) {
      const response = await fetch(api + path, options);
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.message || "通信に失敗しました。もう一度お試しください。");
      return body;
    }

    // Page表示時の入口。Eventを取得してから、そのEventのSeatを取得する。
    async function load() {
      try {
        const result = await request("/events");
        state.event = result.events[0];
        if (!state.event) throw new Error("販売中のイベントがありません。");
        renderEvent();
        await loadSeats();
      } catch (error) {
        showMessage(error.message, "error");
        el.seats.innerHTML = "";
        el.availability.textContent = "取得できませんでした";
      }
    }

    // 選択中Seatが別Requestで確保された可能性も考慮し、最新状態で選択を検証し直す。
    async function loadSeats() {
      const result = await request("/events/" + encodeURIComponent(state.event.id) + "/seats");
      state.seats = result.seats;
      if (state.selected) state.selected = state.seats.find((seat) => seat.id === state.selected.id && seat.status === "available") || null;
      renderSeats();
      renderSummary();
    }

    // APIのEvent DataをHeroとSummaryの2か所へ反映する。
    function renderEvent() {
      const date = new Intl.DateTimeFormat("ja-JP", { year: "numeric", month: "long", day: "numeric", weekday: "short", hour: "2-digit", minute: "2-digit" }).format(new Date(state.event.starts_at));
      el.title.textContent = state.event.name;
      el.date.textContent = date;
      el.venue.textContent = state.event.venue;
      el.summaryName.textContent = state.event.name;
      el.summaryMeta.textContent = date + " · " + state.event.venue;
      document.title = state.event.name + " — VANTA TICKETS";
    }

    // Seat配列からButtonを生成する。textContentを使い、HTML Injectionを避ける。
    function renderSeats() {
      el.availability.textContent = "残り " + state.seats.filter((seat) => seat.status === "available").length + " 席";
      el.seats.replaceChildren(...state.seats.map((seat) => {
        const button = document.createElement("button");
        const selected = state.selected && state.selected.id === seat.id;
        button.type = "button";
        button.className = "seat " + seat.status + (selected ? " selected" : "");
        button.disabled = seat.status !== "available" || state.busy;
        button.setAttribute("aria-pressed", selected ? "true" : "false");
        button.setAttribute("aria-label", seat.seat_label + "、" + yen(seat.price_yen) + (selected ? "、選択中" : ""));
        const code = document.createElement("span");
        code.className = "seat-code";
        code.textContent = seat.seat_label;
        const price = document.createElement("span");
        price.className = "seat-price";
        price.textContent = yen(seat.price_yen);
        button.append(code, price);
        button.addEventListener("click", () => selectSeat(seat));
        return button;
      }));
    }

    // 同じSeatを再Clickすると選択解除、別Seatなら選択を移す。
    function selectSeat(seat) {
      state.selected = state.selected && state.selected.id === seat.id ? null : seat;
      hideMessage();
      renderSeats();
      renderSummary();
    }

    // 選択Seatと料金をSummaryへ反映する。
    function renderSummary() {
      const seat = state.selected;
      el.empty.style.display = seat ? "none" : "grid";
      el.ticket.classList.toggle("visible", Boolean(seat));
      el.selectedName.textContent = seat ? seat.seat_label : "—";
      el.selectedPrice.textContent = seat ? yen(seat.price_yen) : "—";
      el.subtotal.textContent = seat ? yen(seat.price_yen) : "—";
      el.total.textContent = seat ? yen(seat.price_yen + fee) : "—";
      updateButton();
    }

    // Seat、予約者名、通信中でないことの3条件が揃った時だけ予約Buttonを有効にする。
    function updateButton() {
      el.reserve.disabled = !(state.selected && el.customer.value.trim() && !state.busy);
    }

    // POST /reservationsを呼び、成功後にSeat一覧を再取得する。
    async function reserve() {
      if (!state.selected || state.busy) return;
      state.busy = true;
      el.reserve.disabled = true;
      el.reserve.textContent = "座席を確保しています…";
      hideMessage();
      try {
        const result = await request("/reservations", {
          method: "POST", headers: { "content-type": "application/json" },
          body: JSON.stringify({ eventId: state.event.id, seatId: state.selected.id, customerName: el.customer.value.trim(), idempotencyKey: crypto.randomUUID() })
        });
        showMessage("予約を受け付けました。受付番号: " + result.id.slice(0, 8).toUpperCase(), "success");
        state.selected = null;
        await loadSeats();
      } catch (error) {
        showMessage(error.message, "error");
        await loadSeats().catch(() => {});
      } finally {
        state.busy = false;
        el.reserve.textContent = "この内容で予約する";
        renderSeats();
        renderSummary();
      }
    }

    // 金額表示を日本円表記へ統一する。
    function yen(value) { return new Intl.NumberFormat("ja-JP", { style: "currency", currency: "JPY", maximumFractionDigits: 0 }).format(value); }
    // 成功・失敗Messageの表示を共通化する。
    function showMessage(text, type) { el.message.textContent = text; el.message.className = "message visible " + type; }
    function hideMessage() { el.message.textContent = ""; el.message.className = "message"; }

    el.customer.addEventListener("input", updateButton);
    el.reserve.addEventListener("click", reserve);
    load();
  </script>
</body>
</html>
